let currentId = null;
let currentAnswers = [];

function initGrid(){
  const grid = document.getElementById('view-grid');
  grid.innerHTML = '';
  Object.keys(ASSESSMENTS).forEach(id=>{
    const a = ASSESSMENTS[id];
    const qcount = a.customQuestions ? a.customQuestions.length : a.questions.length;
    const card = document.createElement('div');
    card.className = 'card';
    card.onclick = ()=>openAssessment(id);
    card.innerHTML = `
      <div class="icon">${a.code.replace('-','')}</div>
      <div class="code">${a.title}</div>
      <div class="desc">${a.full}</div>
      <div class="qcount">${qcount} ข้อ</div>
    `;
    grid.appendChild(card);
  });
}

function showGrid(){
  document.getElementById('view-grid').style.display = 'grid';
  document.getElementById('view-quiz').style.display = 'none';
  document.getElementById('view-result').style.display = 'none';
  window.scrollTo({top:0,behavior:'smooth'});
}

function openAssessment(id){
  currentId = id;
  const a = ASSESSMENTS[id];
  const qs = a.customQuestions
    ? a.customQuestions
    : a.questions.map(t=>({text:t, options:a.options}));
  currentAnswers = new Array(qs.length).fill(null);

  document.getElementById('quizTitle').textContent = `${a.title} — ${a.full}`;
  document.getElementById('quizSub').textContent = a.sub;

  const list = document.getElementById('questionList');
  list.innerHTML = '';
  qs.forEach((q,i)=>{
    const block = document.createElement('div');
    block.className = 'question';
    let optsHtml = '';
    q.options.forEach((opt,j)=>{
      optsHtml += `
        <label class="opt" id="opt-${i}-${j}">
          <input type="radio" name="q${i}" value="${opt.score}" onchange="selectOpt(${i},${j},${opt.score})">
          ${opt.label}
        </label>`;
    });
    block.innerHTML = `
      <div class="qnum">ข้อที่ ${i+1} จาก ${qs.length}</div>
      <div class="qtext">${q.text}</div>
      <div class="options">${optsHtml}</div>
    `;
    list.appendChild(block);
  });

  updateProgress();
  document.getElementById('view-grid').style.display = 'none';
  document.getElementById('view-result').style.display = 'none';
  document.getElementById('view-quiz').style.display = 'block';
  window.scrollTo({top:0,behavior:'smooth'});
}

function selectOpt(i,j,score){
  currentAnswers[i] = score;
  document.querySelectorAll(`[id^="opt-${i}-"]`).forEach(el=>el.classList.remove('selected'));
  document.getElementById(`opt-${i}-${j}`).classList.add('selected');
  updateProgress();
}

function updateProgress(){
  const total = currentAnswers.length;
  const answered = currentAnswers.filter(v=>v!==null).length;
  const pct = Math.round((answered/total)*100);
  document.getElementById('progressFill').style.width = pct+'%';
  document.getElementById('progressHint').textContent = `ตอบแล้ว ${answered} จาก ${total} ข้อ`;
  document.getElementById('submitBtn').disabled = answered < total;
}

function submitQuiz(){
  const a = ASSESSMENTS[currentId];
  const score = currentAnswers.reduce((s,v)=>s+v,0);
  const band = a.bands.find(b=>score>=b.min && score<=b.max) || a.bands[a.bands.length-1];

  document.getElementById('resultCode').textContent = a.code;
  document.getElementById('resultTitle').textContent = a.full;
  document.getElementById('resultScore').textContent = score;
  document.getElementById('resultScore').style.color = band.color;
  document.getElementById('resultScoreLabel').textContent = 'คะแนนรวม';

  document.getElementById('resultBadgeWrap').innerHTML =
    `<span class="level-badge" style="background:${band.color}">${band.label}</span>`;

  document.getElementById('resultAdvice').innerHTML = `<b>คำแนะนำ:</b> ${band.advice}`;

  // Special check: 9Q question 9 (self-harm item) triggers crisis box even if total score is moderate
  let forceCrisis = band.crisis;
  if(currentId === '9q' && currentAnswers[8] > 0){ forceCrisis = true; }

  document.getElementById('resultCrisis').style.display = forceCrisis ? 'block' : 'none';

  const now = new Date();
  lastResult = {
    code:a.code, full:a.full, score:score, levelLabel:band.label,
    dateStr: now.toLocaleDateString('th-TH', {year:'numeric',month:'long',day:'numeric'})
  };

  document.getElementById('view-quiz').style.display = 'none';
  document.getElementById('view-result').style.display = 'block';
  window.scrollTo({top:0,behavior:'smooth'});
}

let lastResult = null;

function emailResult(){
  if(!lastResult) return;
  const to = document.getElementById('emailTo').value.trim();
  if(!to){ alert('กรุณากรอกอีเมลผู้รับ'); return; }

  const {code, full, score, levelLabel, dateStr} = lastResult;
  const subject = `ผลแบบประเมิน ${code} — ${full}`;
  const body =
`ผลแบบคัดกรองสุขภาพจิต (Mental Health Cyber-Care)

แบบประเมิน: ${code} (${full})
วันที่ทำแบบประเมิน: ${dateStr}
คะแนนรวม: ${score}
ระดับผล: ${levelLabel}

หมายเหตุ: ผลนี้เป็นการคัดกรองเบื้องต้นเท่านั้น ไม่ใช่การวินิจฉัยโรค หากมีข้อสงสัยโปรดปรึกษา อสม. หรือเจ้าหน้าที่สาธารณสุขในพื้นที่
สายด่วนสุขภาพจิต 1323 (ฟรี ตลอด 24 ชม.)`;

  const gmailUrl = `https://mail.google.com/mail/?view=cm&fs=1&to=${encodeURIComponent(to)}&su=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  window.open(gmailUrl, '_blank');
}

initGrid();
showGrid();
