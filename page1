<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>แบบคัดกรองสุขภาพจิตเบื้องต้น</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Kanit:wght@500;600;700&family=Sarabun:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg-sage:#AFC4A2;
    --bg-sage-deep:#8FAA82;
    --surface:#FBFAF5;
    --surface-alt:#F1EEE3;
    --ink:#2B3A2E;
    --ink-soft:#5B6B5A;
    --teal:#357B72;
    --teal-deep:#245A53;
    --gold:#B98A2E;
    --coral:#C85A3F;
    --coral-soft:#F3DCD3;
    --line:#D9DFCE;
    --radius:18px;
    --shadow:0 10px 30px rgba(40,58,42,0.14);
  }
  *{box-sizing:border-box;}
  body{
    margin:0;
    background:linear-gradient(180deg,var(--bg-sage) 0%,var(--bg-sage-deep) 100%);
    font-family:'Sarabun',sans-serif;
    color:var(--ink);
    min-height:100vh;
    padding-bottom:40px;
  }
  h1,h2,h3,.display{font-family:'Kanit',sans-serif;}

  /* ---- Hotline banner ---- */
  .hotline-bar{
    background:var(--teal-deep);
    color:#fff;
    text-align:center;
    padding:9px 16px;
    font-size:14px;
    letter-spacing:.2px;
  }
  .hotline-bar b{color:#F4D8A8;}

  header.top{
    max-width:920px;
    margin:0 auto;
    padding:36px 24px 18px;
    text-align:center;
  }
  header.top .eyebrow{
    font-size:13px;
    letter-spacing:2px;
    color:var(--teal-deep);
    font-weight:600;
    margin-bottom:8px;
  }
  header.top h1{
    font-size:28px;
    margin:0 0 10px;
    color:var(--ink);
  }
  header.top p{
    font-size:15px;
    color:var(--ink-soft);
    max-width:560px;
    margin:0 auto;
    line-height:1.7;
  }

  main{max-width:920px;margin:0 auto;padding:10px 20px 20px;}

  /* ---- Grid of assessment cards ---- */
  .grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:18px;
    margin-top:22px;
  }
  @media (max-width:720px){ .grid{grid-template-columns:repeat(2,1fr);} }
  @media (max-width:460px){ .grid{grid-template-columns:1fr;} }

  .card{
    background:var(--surface);
    border-radius:var(--radius);
    padding:22px 18px;
    text-align:center;
    box-shadow:var(--shadow);
    cursor:pointer;
    border:1px solid transparent;
    transition:transform .18s ease, border-color .18s ease;
  }
  .card:hover{transform:translateY(-4px);border-color:var(--teal);}
  .card .icon{
    width:56px;height:56px;border-radius:50%;
    background:var(--teal);
    color:#fff;
    display:flex;align-items:center;justify-content:center;
    margin:0 auto 14px;
    font-family:'Kanit',sans-serif;
    font-weight:600;
    font-size:17px;
  }
  .card .code{
    font-family:'Kanit',sans-serif;
    font-weight:600;
    font-size:16px;
    color:var(--ink);
    margin-bottom:4px;
  }
  .card .desc{
    font-size:12.5px;
    color:var(--ink-soft);
    line-height:1.5;
    margin-bottom:12px;
  }
  .card .qcount{
    display:inline-block;
    font-size:11.5px;
    color:var(--teal-deep);
    background:#E4EFE0;
    border-radius:20px;
    padding:3px 10px;
  }

  /* ---- Quiz view ---- */
  .panel{
    background:var(--surface);
    border-radius:var(--radius);
    box-shadow:var(--shadow);
    padding:28px 26px;
    margin-top:20px;
  }
  .back-link{
    display:inline-flex;align-items:center;gap:6px;
    background:none;border:none;cursor:pointer;
    color:var(--teal-deep);
    font-family:'Sarabun',sans-serif;
    font-size:14px;font-weight:600;
    margin-bottom:14px;padding:0;
  }
  .quiz-title{font-size:22px;margin:0 0 4px;}
  .quiz-sub{font-size:13.5px;color:var(--ink-soft);margin:0 0 18px;line-height:1.6;}

  .progress-wrap{
    background:var(--surface-alt);
    border-radius:20px;
    height:8px;
    overflow:hidden;
    margin-bottom:24px;
  }
  .progress-fill{
    background:var(--teal);
    height:100%;
    width:0%;
    transition:width .25s ease;
  }

  .question{
    border-top:1px solid var(--line);
    padding:18px 0;
  }
  .question:first-of-type{border-top:none;}
  .question .qnum{
    font-family:'Kanit',sans-serif;
    font-size:12.5px;
    color:var(--teal-deep);
    font-weight:600;
    margin-bottom:6px;
  }
  .question .qtext{
    font-size:15.5px;
    line-height:1.6;
    margin-bottom:12px;
  }
  .options{display:flex;flex-direction:column;gap:8px;}
  .opt{
    display:flex;align-items:center;gap:10px;
    border:1px solid var(--line);
    border-radius:12px;
    padding:10px 14px;
    cursor:pointer;
    font-size:14px;
    transition:border-color .15s, background .15s;
  }
  .opt:hover{border-color:var(--teal);}
  .opt input{accent-color:var(--teal);width:16px;height:16px;flex:none;}
  .opt.selected{border-color:var(--teal);background:#EAF3E9;font-weight:600;}

  .submit-row{margin-top:22px;text-align:center;}
  .btn-primary{
    background:var(--teal-deep);
    color:#fff;
    border:none;
    padding:13px 30px;
    border-radius:30px;
    font-family:'Sarabun',sans-serif;
    font-size:15px;
    font-weight:700;
    cursor:pointer;
    transition:background .15s, opacity .15s;
  }
  .btn-primary:hover{background:var(--teal);}
  .btn-primary:disabled{opacity:.4;cursor:not-allowed;}
  .btn-ghost{
    background:none;
    border:1.5px solid var(--teal-deep);
    color:var(--teal-deep);
    padding:11px 26px;
    border-radius:30px;
    font-family:'Sarabun',sans-serif;
    font-size:14.5px;
    font-weight:600;
    cursor:pointer;
  }
  .hint{
    text-align:center;
    font-size:12.5px;
    color:var(--ink-soft);
    margin-top:10px;
  }

  /* ---- Results view ---- */
  .result-head{text-align:center;margin-bottom:6px;}
  .gauge-wrap{display:flex;justify-content:center;margin:8px 0 6px;}
  .score-big{
    font-family:'Kanit',sans-serif;
    font-size:44px;
    font-weight:700;
    text-align:center;
    margin:2px 0 0;
  }
  .score-label{text-align:center;font-size:13px;color:var(--ink-soft);margin-bottom:18px;}
  .level-badge{
    display:block;
    width:fit-content;
    margin:0 auto 20px;
    padding:7px 18px;
    border-radius:30px;
    font-family:'Kanit',sans-serif;
    font-weight:600;
    font-size:14.5px;
    color:#fff;
  }
  .advice-box{
    background:var(--surface-alt);
    border-radius:14px;
    padding:18px 20px;
    font-size:14.5px;
    line-height:1.75;
    margin-bottom:14px;
  }
  .advice-box b{color:var(--teal-deep);}
  .crisis-box{
    background:var(--coral-soft);
    border:1.5px solid var(--coral);
    border-radius:14px;
    padding:18px 20px;
    font-size:14.5px;
    line-height:1.75;
    margin-bottom:18px;
  }
  .crisis-box .title{
    font-family:'Kanit',sans-serif;
    font-weight:600;
    color:var(--coral);
    margin-bottom:6px;
    font-size:15px;
  }
  .email-box{
    background:var(--surface-alt);
    border-radius:14px;
    padding:16px 18px;
    margin-bottom:6px;
  }
  .email-box label{
    display:block;
    font-size:13px;
    font-weight:600;
    color:var(--teal-deep);
    margin-bottom:8px;
  }
  .email-row{
    display:flex;
    gap:10px;
    flex-wrap:wrap;
  }
  .email-row input{
    flex:1;
    min-width:220px;
    padding:10px 14px;
    border-radius:10px;
    border:1px solid var(--line);
    font-family:'Sarabun',sans-serif;
    font-size:14px;
    background:#fff;
  }
  .email-row input:focus{outline:2px solid var(--teal);border-color:var(--teal);}
  .email-row .btn-ghost{white-space:nowrap;}

  .result-actions{
    display:flex;
    gap:12px;
    justify-content:center;
    flex-wrap:wrap;
    margin-top:20px;
  }
  footer.note{
    max-width:920px;
    margin:26px auto 0;
    padding:0 24px;
    text-align:center;
    font-size:12px;
    color:var(--ink);
    opacity:.75;
    line-height:1.7;
  }
</style>
</head>
<body>

<div class="hotline-bar">สายด่วนสุขภาพจิต <b>1323</b> ให้บริการฟรีตลอด 24 ชั่วโมง — หากรู้สึกไม่ปลอดภัย โทรได้ทันที</div>

<header class="top">
  <div class="eyebrow">MENTAL HEALTH CYBER-CARE</div>
  <h1>แบบคัดกรองทั่วไป (Screening Tools)</h1>
  <p>เลือกแบบประเมินที่ต้องการทำ แต่ละแบบใช้เวลาไม่กี่นาที ผลที่ได้เป็นการคัดกรองเบื้องต้นเท่านั้น ไม่ใช่การวินิจฉัยโรค</p>
</header>

<main>
  <section id="view-grid" class="grid"></section>

  <section id="view-quiz" class="panel" style="display:none;">
    <button class="btn-ghost" onclick="showGrid()" style="margin-bottom:16px;">← ย้อนกลับ</button>
    <h2 class="quiz-title" id="quizTitle"></h2>
    <p class="quiz-sub" id="quizSub"></p>
    <div class="progress-wrap"><div class="progress-fill" id="progressFill"></div></div>
    <div id="questionList"></div>
    <div class="submit-row">
      <button class="btn-primary" id="submitBtn" disabled onclick="submitQuiz()">ดูผลการประเมิน</button>
      <div class="hint" id="progressHint"></div>
    </div>
  </section>

  <section id="view-result" class="panel" style="display:none;">
    <button class="btn-ghost" onclick="showGrid()" style="margin-bottom:16px;">← ย้อนกลับ</button>
    <div class="result-head">
      <div class="eyebrow" id="resultCode" style="color:var(--teal-deep);font-size:12.5px;letter-spacing:1.5px;font-weight:600;"></div>
      <h2 class="quiz-title" id="resultTitle" style="margin-top:4px;"></h2>
    </div>
    <div class="score-big" id="resultScore"></div>
    <div class="score-label" id="resultScoreLabel"></div>
    <div id="resultBadgeWrap" style="text-align:center;"></div>
    <div class="advice-box" id="resultAdvice"></div>
    <div class="crisis-box" id="resultCrisis" style="display:none;">
      <div class="title">⚠ หากมีความคิดทำร้ายตนเองหรือไม่ปลอดภัย</div>
      โปรดติดต่อ อสม. หรือเจ้าหน้าที่สาธารณสุขในพื้นที่โดยทันที หรือโทรสายด่วนสุขภาพจิต <b>1323</b> (ฟรี ตลอด 24 ชั่วโมง) หรือไปโรงพยาบาลที่ใกล้ที่สุด อย่าปล่อยให้ตนเองอยู่ตามลำพัง
    </div>
    <div class="email-box">
      <label for="emailTo">ส่งผลไปที่อีเมล</label>
      <div class="email-row">
        <input type="email" id="emailTo" value="67319100012@Aitc.ac.th">
        <button class="btn-ghost" onclick="emailResult()">✉ ส่งผลทางอีเมล</button>
      </div>
      <div class="hint">จะเปิดหน้าเขียนอีเมลของ Gmail ในแท็บใหม่ พร้อมกรอกผลให้อัตโนมัติ ท่านเพียงกดส่ง (ต้องเข้าสู่ระบบ Gmail ไว้ก่อน)</div>
    </div>
    <div class="result-actions">
      <button class="btn-ghost" onclick="openAssessment(currentId)">ทำแบบประเมินนี้อีกครั้ง</button>
      <button class="btn-primary" onclick="showGrid()">เลือกแบบประเมินอื่น</button>
    </div>
  </section>
</main>

<footer class="note">
  แบบประเมินนี้ดัดแปลงจากเครื่องมือคัดกรองมาตรฐานที่ใช้ในระบบสาธารณสุขไทย ผลลัพธ์เป็นเพียงการคัดกรองเบื้องต้น ไม่สามารถใช้แทนการวินิจฉัยของแพทย์หรือผู้เชี่ยวชาญได้ หากมีข้อสงสัยเกี่ยวกับผลประเมิน โปรดปรึกษา อสม. หรือเจ้าหน้าที่สาธารณสุขใกล้บ้าน
</footer>

<script>
const scale4 = [
  {label:'ไม่มีเลย', score:0},
  {label:'เป็นบางวัน (1–7 วัน)', score:1},
  {label:'เป็นบ่อย (มากกว่า 7 วัน)', score:2},
  {label:'เป็นทุกวัน', score:3}
];
const yesNo = [
  {label:'ไม่มี', score:0},
  {label:'มี', score:1}
];
const freq5 = [
  {label:'ไม่เคยเลย', score:0},
  {label:'เป็นบางครั้ง', score:1},
  {label:'เป็นบ่อยครั้ง', score:2},
  {label:'เป็นประจำ', score:3}
];

const auditFreq = [
  {label:'ไม่เคย', score:0},
  {label:'น้อยกว่าเดือนละครั้ง', score:1},
  {label:'เดือนละครั้ง', score:2},
  {label:'สัปดาห์ละครั้ง', score:3},
  {label:'ทุกวันหรือเกือบทุกวัน', score:4}
];
const auditConcern = [
  {label:'ไม่เคย', score:0},
  {label:'เคย แต่ไม่ใช่ในปีที่ผ่านมา', score:2},
  {label:'เคยในปีที่ผ่านมา', score:4}
];

const ASSESSMENTS = {
  '2q':{
    code:'2Q', title:'2Q', full:'คัดกรองภาวะซึมเศร้าเบื้องต้น',
    sub:'คำถาม 2 ข้อสำหรับคัดกรองความเสี่ยงภาวะซึมเศร้าในช่วง 2 สัปดาห์ที่ผ่านมา',
    scaleType:'yesno',
    options:yesNo,
    questions:[
      'ใน 2 สัปดาห์ที่ผ่านมารวมวันนี้ ท่านรู้สึกหดหู่ เศร้า หรือท้อแท้สิ้นหวังหรือไม่',
      'ใน 2 สัปดาห์ที่ผ่านมารวมวันนี้ ท่านรู้สึกเบื่อ ทำอะไรก็ไม่เพลิดเพลินหรือไม่'
    ],
    bands:[
      {min:0,max:0,label:'ไม่มีภาวะซึมเศร้า',color:'var(--teal)',crisis:false,
        advice:'ผลการคัดกรองไม่พบสัญญาณของภาวะซึมเศร้าในขณะนี้ หากในอนาคตรู้สึกเศร้าหรือเบื่อหน่ายต่อเนื่อง สามารถกลับมาทำแบบประเมินนี้ใหม่ได้เสมอ'},
      {min:1,max:2,label:'มีความเสี่ยง ควรประเมินต่อ',color:'var(--gold)',crisis:false,
        advice:'พบสัญญาณที่อาจเกี่ยวข้องกับภาวะซึมเศร้า แนะนำให้ทำแบบประเมิน <b>9Q</b> ต่อ เพื่อประเมินความรุนแรงอย่างละเอียดขึ้น และปรึกษา อสม. หรือเจ้าหน้าที่สาธารณสุขในพื้นที่'}
    ]
  },
  '9q':{
    code:'9Q', title:'9Q', full:'ประเมินความรุนแรงของโรคซึมเศร้า',
    sub:'ประเมินความถี่ของอาการต่าง ๆ ในช่วง 2 สัปดาห์ที่ผ่านมา (ดัดแปลงจาก PHQ-9 ฉบับภาษาไทย)',
    scaleType:'uniform', options:scale4,
    questions:[
      'เบื่อ ไม่สนใจอยากทำอะไร',
      'ไม่สบายใจ ซึมเศร้า ท้อแท้',
      'หลับยาก หลับไม่ทน หรือหลับมากไป',
      'เหนื่อยง่าย หรือไม่ค่อยมีแรง',
      'เบื่ออาหาร หรือกินมากเกินไป',
      'รู้สึกไม่ดีกับตัวเอง คิดว่าล้มเหลว หรือทำให้ตนเอง/ครอบครัวผิดหวัง',
      'สมาธิไม่ดีเวลาทำอะไร เช่น ดูโทรทัศน์ ฟังวิทยุ หรืองานที่ต้องใช้สมาธิ',
      'พูดหรือทำอะไรช้าจนคนอื่นสังเกตเห็น หรือกระสับกระส่ายอยู่ไม่นิ่งกว่าปกติ',
      'คิดทำร้ายตนเอง หรือคิดว่าตายไปเสียดีกว่า'
    ],
    special9: true,
    bands:[
      {min:0,max:6,label:'ไม่มีภาวะซึมเศร้า / น้อยมาก',color:'var(--teal)',crisis:false,
        advice:'คะแนนอยู่ในเกณฑ์ปกติ ดูแลสุขภาพใจต่อเนื่อง เช่น พักผ่อนให้พอ ออกกำลังกาย และพูดคุยกับคนใกล้ชิดเมื่อรู้สึกไม่สบายใจ'},
      {min:7,max:12,label:'ซึมเศร้าระดับน้อย',color:'var(--gold)',crisis:false,
        advice:'มีอาการซึมเศร้าระดับเล็กน้อย แนะนำให้ปรึกษา อสม. หรือเจ้าหน้าที่สาธารณสุข เพื่อติดตามอาการและรับคำแนะนำการดูแลตนเอง'},
      {min:13,max:18,label:'ซึมเศร้าระดับปานกลาง',color:'var(--coral)',crisis:false,
        advice:'มีอาการซึมเศร้าระดับปานกลาง ควรพบเจ้าหน้าที่สาธารณสุขหรือแพทย์เพื่อรับการประเมินและวางแผนดูแลอย่างเหมาะสมโดยเร็ว'},
      {min:19,max:27,label:'ซึมเศร้าระดับรุนแรง',color:'var(--coral)',crisis:true,
        advice:'มีอาการซึมเศร้าระดับรุนแรง ควรพบแพทย์หรือเจ้าหน้าที่สาธารณสุขโดยเร็วที่สุด ไม่ควรปล่อยไว้'}
    ]
  },
  '8q':{
