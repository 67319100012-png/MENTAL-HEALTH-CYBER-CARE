// Global App State
let currentId = null;
let currentAnswers = [];
let lastResult = null;

function initGrid() {
  const grid = document.getElementById('view-grid');
  grid.innerHTML = '';
  Object.keys(ASSESSMENTS).forEach(id => {
    const a = ASSESSMENTS[id];
    let qcount = a.items.length + ' ข้อ';
    const card = document.createElement('div');
    card.className = 'card';
    card.style.setProperty('--accent', a.accent);
    card.style.setProperty('--accent-soft', a.accentSoft);
    card.onclick = () => openAssessment(id);
    card.innerHTML = `
      <div class="emoji-badge">${a.emoji}</div>
      <div class="code">${a.title} — ${a.full}</div>
      <div class="desc">${a.sub}</div>
      <span class="tag">${qcount}</span>
    `;
    grid.appendChild(card);
  });
}

function showGrid() {
  ['view-grid','view-quiz','view-result'].forEach(v => document.getElementById(v).style.display = 'none');
  document.getElementById('view-grid').style.display = 'grid';
  window.scrollTo({top: 0, behavior: 'smooth'});
}

function hideAll() {
  ['view-grid','view-quiz','view-result'].forEach(v => document.getElementById(v).style.display = 'none');
}

function openAssessment(id) {
  currentId = id;
  const a = ASSESSMENTS[id];

  document.getElementById('quizTitle').textContent = `${a.title} — ${a.full}`;
  document.getElementById('quizSub').textContent = a.sub;
  document.getElementById('quizNote').style.display = a.staffOnly ? 'block' : 'none';
  if (a.staffOnly) {
    document.getElementById('quizNote').innerHTML = '<i class="fa-solid fa-lightbulb"></i> คำแนะนำสำหรับผู้ประเมิน: กรุณาสัมภาษณ์ด้วยน้ำเสียงนุ่มนวล ชัดเจน ไม่เร่งรัด และบันทึกคำตอบตามความเป็นจริง';
  }
  renderQuestionList(a.items);
  hideAll();
  document.getElementById('view-quiz').style.display = 'block';
  window.scrollTo({top: 0, behavior: 'smooth'});
}

function renderQuestionList(qs) {
  currentAnswers = new Array(qs.length).fill(null);
  const list = document.getElementById('questionList');
  list.innerHTML = '';
  qs.forEach((q, i) => {
    const block = document.createElement('div');
    block.className = 'question';
    let optsHtml = '';
    q.options.forEach((opt, j) => {
      optsHtml += `<label class="opt" id="opt-${i}-${j}"><input type="radio" name="q${i}" value="${opt.score}" onchange="selectOpt(${i},${j},${opt.score})"> <span>${opt.label}</span></label>`;
    });
    block.innerHTML = `<div class="qtext">${q.text}</div><div class="options">${optsHtml}</div>`;
    list.appendChild(block);
  });
  updateProgress();
}

function selectOpt(i, j, score) {
  currentAnswers[i] = score;
  document.querySelectorAll(`[id^="opt-${i}-"]`).forEach(el => el.classList.remove('selected'));
  document.getElementById(`opt-${i}-${j}`).classList.add('selected');
  updateProgress();
}

function updateProgress() {
  const total = currentAnswers.length;
  const answered = currentAnswers.filter(v => v !== null).length;
  const pct = total ? Math.round((answered / total) * 100) : 0;
  document.getElementById('progressFill').style.width = pct + '%';
  document.getElementById('progressHint').textContent = `ตอบแล้ว ${answered} จาก ${total} ข้อ`;
  document.getElementById('submitBtn').disabled = answered < total;
}

function submitQuiz() {
  const a = ASSESSMENTS[currentId];
  const score = currentAnswers.reduce((s, v) => s + v, 0);
  const band = a.bands.find(b => score >= b.min && score <= b.max) || a.bands[a.bands.length - 1];
  
  document.getElementById('resultCode').textContent = a.code;
  document.getElementById('resultTitle').textContent = a.full;
  document.getElementById('resultScore').textContent = `${score} / ${a.items.length * (a.items[0].options[a.items[0].options.length-1].score || 1)}`;
  document.getElementById('resultScoreLabel').textContent = 'คะแนนรวมการประเมิน';

  const badgeWrap = document.getElementById('resultBadgeWrap');
  badgeWrap.innerHTML = `<span class="level-badge" style="background:${band.color}">${band.label}</span>`;

  document.getElementById('resultAdvice').innerHTML = band.advice;
  
  const crisisBox = document.getElementById('resultCrisis');
  if (band.crisis) {
    crisisBox.style.display = 'block';
  } else {
    crisisBox.style.display = 'none';
  }

  lastResult = {
    code: a.code,
    title: a.full,
    score: score,
    band: band.label,
    advice: band.advice.replace(/<br>/g, '\n').replace(/<\/?[^>]+(>|$)/g, "")
  };

  hideAll();
  document.getElementById('view-result').style.display = 'block';
  window.scrollTo({top: 0, behavior: 'smooth'});
}

function emailResult() {
  const email = document.getElementById('emailTo').value.trim();
  if (!email) { alert('กรุณากรอกอีเมลผู้รับ'); return; }
  if (!lastResult) return;

  const subject = encodeURIComponent(`[ผลการประเมินสุขภาพจิตผู้สูงอายุ] ${lastResult.code} — ${lastResult.band}`);
  const body = encodeURIComponent(
    `สรุปผลการประเมินสุขภาพจิตและสมองผู้สูงอายุ\n` +
    `โครงการ อสม. ฮีลใจผู้สูงอายุ\n` +
    `----------------------------------------\n` +
    `แบบประเมิน: ${lastResult.code} (${lastResult.title})\n` +
    `คะแนนที่ได้: ${lastResult.score}\n` +
    `แปลผลการประเมิน: ${lastResult.band}\n\n` +
    `ข้อแนะนำ/แนวทางการดูแล:\n${lastResult.advice}\n\n` +
    `----------------------------------------\n` +
    `หมายเหตุ: ข้อมูลนี้เป็นผลคัดกรองเบื้องต้นเท่านั้น`
  );

  window.open(`https://mail.google.com/mail/?view=cm&fs=1&to=${email}&su=${subject}&body=${body}`, '_blank');
}

// Initial Load
document.addEventListener('DOMContentLoaded', () => {
  initGrid();
});
</script>
