    color: var(--ink);
    min-height: 100vh;
    padding-bottom: 50px;
  }

  /* ---------------- Hotline Bar ---------------- */
  .hotline-bar {
    background: var(--forest-deep);
    color: #fff;
    text-align: center;
    padding: 8px 16px;
    font-size: 0.85rem;
    font-family: var(--body-font);
  }
  .hotline-bar b { color: var(--marigold); }

  /* ---------------- Navbar ---------------- */
  header.nav-header {
    background: rgba(251,247,238,0.86);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(30,74,52,0.08);
    padding: 16px 6%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: sticky;
    top: 0;
    z-index: 1000;
  }
  header.nav-header .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--display-font);
    font-weight: 700;
    font-size: 1.02rem;
    color: var(--forest);
    text-decoration: none;
  }
  header.nav-header .logo .badge {
    width: 38px; height: 38px;
    border-radius: 50%;
    background: linear-gradient(150deg, var(--sage), var(--forest));
    color: #fff;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.05rem;
    box-shadow: 0 4px 10px rgba(30,74,52,0.25);
  }
  header.nav-header .logo small {
    display: block;
    font-family: var(--body-font);
    font-weight: 400;
    font-size: 0.68rem;
    color: var(--ink-soft);
