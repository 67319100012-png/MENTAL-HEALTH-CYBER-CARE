<script>
// Options Standard
const yesNo = [ {label:'ไม่ใช่ / ไม่มี', score:0}, {label:'ใช่ / มี', score:1} ];
const yesNoRev = [ {label:'ใช่ / มี', score:0}, {label:'ไม่ใช่ / ไม่มี', score:1} ];

const amtOptions = [ {label:'ตอบถูกต้อง', score:1}, {label:'ตอบผิด / ตอบไม่ได้', score:0} ];

const scale4GMHA = [
  {label:'ไม่เคยเลย / น้อยมาก', score:0}, 
  {label:'บางครั้ง (1-2 วัน/สัปดาห์)', score:1}, 
  {label:'บ่อยครั้ง (3-4 วัน/สัปดาห์)', score:2}, 
  {label:'เป็นประจำ (เกือบทุกวัน)', score:3}
];

// TGDS-15 Items (Thai Geriatric Depression Scale)
const TGDS_ITEMS = [
  {text:'1. โดยทั่วไปท่านพึงพอใจกับชีวิตความเป็นอยู่ของท่านหรือไม่', options:yesNoRev},
  {text:'2. ท่านได้ละเลิกกิจกรรมหรืองานความสนใจส่วนใหญ่ไปหรือไม่', options:yesNo},
  {text:'3. ท่านรู้สึกว่าชีวิตของท่านว่างเปล่าหรือไม่', options:yesNo},
  {text:'4. ท่านรู้สึกเบื่อหน่ายบ่อยๆ หรือไม่', options:yesNo},
  {text:'5. ท่านหวังว่าจะมีอะไรดีๆ เกิดขึ้นกับท่านในวันข้างหน้าหรือไม่', options:yesNoRev},
  {text:'6. ท่านกลัวว่าจะมีเรื่องไม่ดีเกิดขึ้นกับท่านหรือไม่', options:yesNo},
